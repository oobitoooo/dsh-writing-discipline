{
  "name": "dsh-writing-discipline",
  "version": "0.3.0",
  "description": "写作纪律闸门：扫描防御性写作与模型味（破折号过密、「不是X而是Y」、软对冲、免责、过程旁白），带事实守恒锁、确定性改写器与 present 前交付闸门（按内容 sha256 记账，未过扫或扫完又改文件一律拦下）。支持 .docx/.pptx/.xlsx 直接抽取。零网络、零 LLM、纯本地正则与统计。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./rules": "./lib/rules.js",
    "./gate": "./lib/gate.js",
    "./extract": "./lib/extract.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "wd-lint": "bin/wd-lint.mjs"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "docs",
    "skills",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/rules.js && node --check lib/gate.js && node --check lib/extract.js && node --check bin/wd-lint.mjs",
    "test": "node test/smoke.mjs && node test/gate.mjs",
    "bench": "node test/bench.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0",
    "@deepseek-ai/cordis": ">=3.0.0"
  },
  "devDependencies": {},
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "writing",
    "defensive-writing",
    "hedging",
    "lint",
    "style",
    "chinese",
    "prompt-discipline",
    "gate",
    "docx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oobitoooo/dsh-writing-discipline.git"
  },
  "homepage": "https://github.com/oobitoooo/dsh-writing-discipline#readme",
  "bugs": {
    "url": "https://github.com/oobitoooo/dsh-writing-discipline/issues"
  },
  "license": "MIT"
}
